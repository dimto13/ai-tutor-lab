{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-train-lab.local/schemas/classification-scheme.schema.json",
  "title": "ClassificationSchemeDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["classificationScheme"],
  "properties": {
    "classificationScheme": {
      "$ref": "#/$defs/classificationScheme"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "classificationLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "minLevel"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 },
        "minLevel": { "$ref": "#/$defs/stableId" }
      }
    },
    "aiToolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "maxLevel"],
      "properties": {
        "tool": { "$ref": "#/$defs/stableId" },
        "maxLevel": { "$ref": "#/$defs/stableId" }
      }
    },
    "classificationScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "levels", "indicators", "aiPolicy", "defaultOnUncertainty"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/stableId" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/classificationLevel" }
        },
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/indicator" }
        },
        "aiPolicy": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/aiToolPolicy" }
        },
        "defaultOnUncertainty": {
          "const": "escalate"
        }
      }
    }
  }
}
