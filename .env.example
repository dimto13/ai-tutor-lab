# AITP-54 — local-first tutor LLM provider
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:31b
# Smaller manually selectable fallback for constrained development hardware: gemma4:e4b
# Ollama's local OpenAI-compatible endpoint ignores the API key, but the
# compatibility protocol expects one. Keep this a non-secret local placeholder.
LLM_API_KEY=ollama
